# Use a flat (hoisted), non-symlinked node_modules structure instead of
# pnpm's default. pnpm's default symlink-based structure has repeatedly
# tripped up Vercel's build-time file tracer for native/binary packages
# specifically (@napi-rs/canvas's js-binding.js at build time, then its
# index.js at runtime; pdfjs-dist's worker file similarly) -- the tracer
# doesn't reliably follow pnpm's nested .pnpm/<pkg>@<version>/node_modules/
# symlink structure, resulting in malformed or missing paths in the
# deployed serverless bundle. A flat structure avoids this whole class of
# issue rather than requiring a one-off workaround for each native
# dependency as it's added.
node-linker=hoisted
